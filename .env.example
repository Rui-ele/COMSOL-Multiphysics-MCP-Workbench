# Set these in the Employee Assistant MCP process environment.
# .env is a template; the launcher must load it to apply its values.
COMSOL_MCP_COMSOL_VERSION=6.4
# Used by connect/start; its executable directory is added to the process PATH.
COMSOL_MCP_COMSOL_ROOT=/ABSOLUTE/PATH/TO/COMSOL/Multiphysics
# Journals: audit/; real acceptance reports: integration_reports/.
# Default: .comsol-mcp-data under the working directory.
COMSOL_MCP_DATA_DIR=/ABSOLUTE/PATH/TO/local-comsol-mcp-data
