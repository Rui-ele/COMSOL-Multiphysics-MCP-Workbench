# Optional overrides for scripts and the real integration test.
# Copy to .env only if your launcher loads environment files explicitly.
COMSOL_MCP_COMSOL_VERSION=6.4
COMSOL_MCP_COMSOL_ROOT=/ABSOLUTE/PATH/TO/COMSOL/Multiphysics
COMSOL_MCP_DATA_DIR=/ABSOLUTE/PATH/TO/local-comsol-mcp-data
COMSOL_MCP_REPORT_DIR=/ABSOLUTE/PATH/TO/local-comsol-mcp-data/simulation_reports
